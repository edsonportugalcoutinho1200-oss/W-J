# Nunca commitar um .env real com valores de produção (por isso ele está
# no .gitignore) — este arquivo é só o modelo.

# Modo demonstração: com "true", todo login/produto/pedido/resumo do
# dashboard usa dados simulados em memória (ver src/mocks/) em vez de
# chamar a API. Ligado por padrão aqui porque o backend ainda não existe.
# Troque para "false" (ou apague a linha) assim que a API estiver no ar —
# e NUNCA deixe "true" em produção (o login simulado aceita qualquer senha).
VITE_USE_MOCKS=true

# URL base da API (Node/NestJS). Só é usada quando VITE_USE_MOCKS=false.
VITE_API_BASE_URL=http://localhost:3000/api
