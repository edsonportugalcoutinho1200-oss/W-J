# Nunca commitar um .env real (por isso ele está no .gitignore) — este
# arquivo é só o modelo.

# Cole aqui a "connection string" do seu cluster no MongoDB Atlas.
# Formato: mongodb+srv://<usuario>:<senha>@<cluster>.mongodb.net/wj-api
# Veja o passo a passo no README.md deste projeto.
MONGO_URI=

# Porta em que a API vai rodar localmente.
PORT=3000

# Origem permitida pelo CORS — o endereço onde o FRONTEND roda.
# Backoffice (Vite): http://localhost:5173
# Se rodar o wj-acessorios (loja) numa porta diferente, ajuste depois.
CORS_ORIGIN=http://localhost:5173
